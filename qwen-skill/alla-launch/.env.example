# Скопируйте в .env рядом с SKILL.md (это делает `setup`) и заполните. Файл .env не коммитится.
# Переменные окружения с теми же именами имеют приоритет над этим файлом.
# Значения пишите без комментариев в конце строки: `KEY=value # note` даст значение с комментарием.
# Адрес сайта TestOps, например https://allure.company.com (без /api в конце):
ALLURE_ENDPOINT=
ALLURE_TOKEN=
# Отключить проверку TLS (корпоративный прокси с самоподписанным сертификатом):
# ALLURE_SSL_VERIFY=false
# Необязательные параметры (значения по умолчанию):
# ALLURE_REQUEST_TIMEOUT=30
# ALLURE_PAGE_SIZE=100
# ALLURE_MAX_PAGES=50
# ALLURE_CLUSTERING_THRESHOLD=0.60
