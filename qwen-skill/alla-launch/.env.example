# Инженер копирует в .env рядом с SKILL.md и заполняет. setup только печатает инструкцию.
# Секреты в .env запрещены: токен хранит Qwen (credentials/qwen-extension.json).
# Переменные окружения с теми же именами имеют приоритет над этим файлом.
# Значения пишите без комментариев в конце строки: `KEY=value # note` даст значение с комментарием.
# Адрес сайта TestOps, например https://allure.company.com (без /api в конце). Скилл читает
# TestOps через его встроенный MCP-сервер (<адрес>/api/mcp, TestOps 26.2.1.8 или новее).
ALLURE_ENDPOINT=
# Инженер из корня проекта устанавливает расширение credentials и сохраняет токен:
# qwen extensions install .qwen/skills/alla-launch/credentials
# qwen extensions settings set alla-launch-credentials ALLURE_TOKEN --scope workspace
# Для CI токен можно передать только переменной окружения ALLURE_TOKEN.
# Номер проекта TestOps (в адресе проекта: …/project/5/…). Многомодульный проект автотестов, где
# у модулей свои проекты, — пары «папка модуля от корня проекта = номер» через запятую:
# ALLURE_PROJECT_ID=orders=5,payments/api=7 (тогда Алла спросит, из какого модуля прогон).
ALLURE_PROJECT_ID=
# Необязательные параметры (значения по умолчанию):
# Свой адрес MCP-сервера, если он не <ALLURE_ENDPOINT>/api/mcp:
# ALLURE_MCP_URL=https://allure.company.com/api/mcp
# ALLURE_REQUEST_TIMEOUT=30
# ALLURE_HTTP_RETRIES=3
# ALLURE_PAGE_SIZE=100
# ALLURE_MAX_PAGES=200
# ALLURE_CLUSTERING_THRESHOLD=0.60
# Скриншоты из вложений: сколько изображений на проблему показать модели (0–3, 0 — не скачивать;
# выключите, если модель Qwen Code не принимает изображения), и потолок размера одного файла:
# ALLURE_IMAGES_PER_PROBLEM=3
# ALLURE_IMAGES_MAX_BYTES=5242880
# Свои ключи id операции через запятую — к встроенным operUID, rqUID, requestId, correlationId,
# traceId. Из общего лога сервиса берутся только записи с id операции теста; свой id тест должен
# нести в сообщении, трейсе или вложении-запросе/ответе, иначе из такого лога ничего не возьмётся:
# ALLURE_OPERATION_ID_KEYS=businessId
# Перезапуск тестов локально (/alla:rerun, Maven): запусков до первого успеха (1–5), тестов за
# раз (0 — выключить), общий потолок времени в секундах и свои аргументы Maven (как в shell):
# ALLURE_RERUN_ATTEMPTS=3
# ALLURE_RERUN_MAX_TESTS=20
# ALLURE_RERUN_TIMEOUT=1800
# ALLURE_RERUN_MAVEN_ARGS=-Pstand
# Отмечать прошедшие при перезапуске тесты статусом passed в прогоне TestOps (после вашего «да»).
# Выключено: запись идёт через REST API TestOps, в MCP её нет. Включайте, только если REST API
# вам открыт и у токена есть право менять результаты тестов в проекте:
# ALLURE_RERUN_RESOLVE=false
